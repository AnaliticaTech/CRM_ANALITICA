# Exemplo seguro: campos vazios; nao usar este arquivo como configuracao pronta.
# Configure valores reais apenas em armazenamento privado aprovado.

# Publicas: incorporadas ao bundle durante o build. Nunca colocar service-role aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# Privadas, somente servidor. Service-role ignora RLS.
SUPABASE_SERVICE_ROLE_KEY=
# AES-256-GCM: 64 caracteres hexadecimais. Rotacao exige plano para dados existentes.
ENCRYPTION_KEY=
# Assinaturas de webhooks Meta.
META_APP_SECRET=
# Obrigatoria quando automacoes com espera utilizarem o agendador cron.
AUTOMATION_CRON_SECRET=

# Identificador Meta: necessario para determinados templates de midia.
META_APP_ID=
# Lista de hosts de convite separados por virgulas, sem esquema/porta.
ALLOWED_INVITE_HOSTS=
# Opcional: true/1 ativa simulacao de templates; vazio nao ativa.
WHATSAPP_TEMPLATES_DRY_RUN=
# Opcional: porta publicada em loopback pelo Compose; vazio usa seu padrao.
CRM_HOST_PORT=
